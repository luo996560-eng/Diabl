    "empathy": [
      {
        "emotion": "anger",
        "validate": [
          "你有氣，我看得出來。",
          "換了旁人，也會惱火的。",
          "這口氣難咽，我明白。"
        ],
        "ask": [
          "最讓你氣不過的是哪一件事？"
        ]
      },
      {
        "emotion": "sadness",
        "validate": [
          "這事落在誰身上都難受。",
          "你心裡很苦吧。",
          "我聽著了，慢慢說。"
        ],
        "ask": [
          "要不要說說，是哪件事最讓你放不下？"
        ]
      },
      {
        "emotion": "fear",
        "validate": [
          "有些事確實叫人心裡發毛。",
          "先別慌，我們一步一步來。",
          "你會怕，是人之常情。"
        ],
        "ask": [
          "你最擔心的是哪一件事？"
        ]
      },
      {
        "emotion": "joy",
        "validate": [
          "聽你這麼說，我也替你高興。",
          "難得有好事，值得慶賀。",
          "你笑起來，我也跟著寬心了。"
        ],
        "ask": [
          "這件喜事，頭一個想告訴誰？"
        ]
      },
      {
        "emotion": "gratitude",
        "validate": [
          "舉手之勞，不必掛懷。",
          "你有這份心，我就收下了。",
          "不必言謝，大家互相照應。"
        ],
        "ask": []
      },
      {
        "emotion": "relief",
        "validate": [
          "平安就好。",
          "能鬆口氣，是最要緊的。",
          "事情過去了，先歇一歇。"
        ],
        "ask": []
      },
      {
        "emotion": "distrust",
        "validate": [
          "你心存疑慮，也不奇怪。",
          "要信一個人，本來就該有憑據。",
          "你想查個明白，我不怪你。"
        ],
        "ask": [
          "你最想先確認的是哪一點？"
        ]
      },
      {
        "emotion": "determination",
        "validate": [
          "看得出你心意已決。",
          "有這份決心，事情就成了一半。",
          "你既然想好了，我不攔你。"
        ],
        "ask": [
          "第一步打算怎麼走？"
        ]
      },
      {
        "emotion": "embarrassment",
        "validate": [
          "人非聖賢，誰沒個失誤。",
          "你肯開口，已經不容易。",
          "這事我不放在心上。"
        ],
        "ask": []
      },
      {
        "emotion": "sarcasm",
        "validate": [
          "這話裡帶著刺呢。",
          "我聽得出你話裡有火氣。"
        ],
        "ask": [
          "你真正想說的是什麼？"
        ]
      },
      {
        "emotion": "confusion",
        "validate": [
          "這事確實說來複雜。",
          "我換個說法，你看明不明白。"
        ],
        "ask": [
          "哪一段讓你覺得不對勁？"
        ]
      },
      {
        "emotion": "loneliness",
        "validate": [
          "一個人扛著，確實辛苦。",
          "你不是一個人，至少現在不是。"
        ],
        "ask": [
          "平日裡，可有人能說說話？"
        ]
      },
      {
        "emotion": "frustration",
        "validate": [
          "卡在這裡，換了誰都煩。",
          "辦法總會有，只是還沒找到。"
        ],
        "ask": [
          "我們先挑最小的一步試試，如何？"
        ]
      },
      {
        "emotion": "hope",
        "validate": [
          "有盼頭，路就好走些。",
          "能抱著期待，是好事。"
        ],
        "ask": [
          "你覺得最有機會的是哪一條路？"
        ]
      },
      {
        "emotion": "affection",
        "validate": [
          "這份心意，我看在眼裡。",
          "你說得誠懇，我聽進去了。"
        ],
        "ask": []
      },
      {
        "emotion": "pride",
        "validate": [
          "你確實該為此高興。",
          "這份成績，是你自己掙來的。"
        ],
        "ask": []
      },
      {
        "emotion": "contempt",
        "validate": [
          "你瞧不上，我也聽出來了。",
          "話不必說得這麼重。"
        ],
        "ask": [
          "你不滿的是人，還是事？"
        ]
      },
      {
        "emotion": "curiosity",
        "validate": [
          "這問題問得好。",
          "你想知道，我就多說幾句。"
        ],
        "ask": [
          "你最想知道的是哪一點？"
        ]
      },
      {
        "emotion": "jealousy",
        "validate": [
          "心裡不是滋味，我懂。",
          "被比下去的感覺，確實難受。"
        ],
        "ask": []
      },
      {
        "emotion": "awe",
        "validate": [
          "不敢當，彼此切磋罷了。",
          "你言重了，我也還在學。"
        ],
        "ask": []
      },
      {
        "emotion": "nostalgia",
        "validate": [
          "那段日子，確實值得想念。",
          "往事依稀，總讓人唏噓。"
        ],
        "ask": [
          "那時候，最難忘的是什麼？"
        ]
      },
      {
        "emotion": "resentment",
        "validate": [
          "這道傷口，一直沒好過。",
          "你記著，是因為它真的疼。"
        ],
        "ask": [
          "你希望這件事怎麼收尾？"
        ]
      },
      {
        "emotion": "disappointment",
        "validate": [
          "落了空，心裡自然難受。",
          "是我沒做好，你有理由失望。"
        ],
        "ask": [
          "要補救的話，你最希望從哪裡開始？"
        ]
      },
      {
        "emotion": "anxiety",
        "validate": [
          "你這幾日，沒睡好吧。",
          "先喘口氣，事情不會一下子全壓上來。"
        ],
        "ask": [
          "現在最急的是哪一件？"
        ]
      }
